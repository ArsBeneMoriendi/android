<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="16dp">

    <!--Imię-->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:labelFor="@id/edtImie"
            android:text="Imię:"/>

        <EditText
            android:id="@+id/edtImie"
            android:layout_width="200dp"
            android:layout_height="wrap_content"

            android:inputType="textPersonName"/>
    </LinearLayout>

    <!--Nazwisko-->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:labelFor="@id/edtNazwisko"
            android:text="Nazwisko:"/>

        <EditText
            android:id="@+id/edtNazwisko"
            android:layout_width="200dp"
            android:layout_height="wrap_content"

            android:inputType="textPersonName"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnDodajAdres"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/dodaj_adres" />

    <TextView
        android:id="@+id/txtAdres"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/brak_adresu" />

    <!--Przyciski-->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/btnWroc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"

            android:text="@string/adres_wroc"/>

        <Button
            android:id="@+id/btnDodajOsobe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="@string/dodaj_osobe"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnUsunOsobe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/usun_osobe"
        android:visibility="gone" />

</LinearLayout>
</ScrollView>
